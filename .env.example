# MemPalace environment configuration
#
# Copy this file to .env (which is gitignored) and fill in any values
# you need. Most users won't need to set anything here — MemPalace runs
# fully local with sensible defaults.
#
# Usage:
#   cp .env.example .env
#   # then edit .env

# ─── Optional: where to store the palace database ─────────────────────────
# Default: ~/.mempalace/db
# Set this if you want the palace stored somewhere other than your home dir.
# MEMPALACE_DB=/path/to/your/palace

# ─── Optional: source directories to mine ─────────────────────────────────
# Colon-separated list of directories containing your raw conversation
# transcripts. Used by `mempalace mine` and the rebuild tools.
# MEMPALACE_SOURCES=/path/to/chats:/path/to/diaries

# ─── Optional: Anthropic API key ──────────────────────────────────────────
# Only needed for LLM-assisted features (closet regeneration, optional
# rerank pass). Leave unset for fully local operation.
# Get yours at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Optional: privacy mode ───────────────────────────────────────────────
# When set to 1 (default), private wings are excluded from search results
# and exports. Set to 0 to include them (NOT recommended unless you're
# the only user of this machine).
# MEMPALACE_PRIVATE_MODE=1
